FROM rockylinux:9

RUN dnf install -y --allowerasing \
    curl \
    iproute \
    iputils \
    bind-utils \
    net-tools \
    openssh-clients \
    openssh-server \
    firewalld \
    sudo \
    && dnf clean all

RUN useradd -m -s /bin/bash testuser && echo "testuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

WORKDIR /opt/shelldock
COPY . .

RUN chmod +x build/shelldock-linux-* 2>/dev/null || true

USER testuser
ENV HOME=/home/testuser
ENV PATH="/opt/shelldock/build:${PATH}"

ENTRYPOINT ["/opt/shelldock/test/sandbox/entrypoint.sh"]
